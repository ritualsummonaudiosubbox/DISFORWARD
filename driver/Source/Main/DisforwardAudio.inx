[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer   = 10/20/2026, 0.4.0.0
CatalogFile = DisforwardAudio.cat
PnpLockDown = 1

[SourceDisksNames]
222="DISFORWARD Driver Disk","",222

[SourceDisksFiles]
disforwardaudio.sys=222

[SignatureAttributes]
disforwardaudio.sys=SignatureAttributes.DRM

[SignatureAttributes.DRM]
DRMLevel=1300

[SignatureAttributes.PETrust]
PETrust=true

[Manufacturer]
%MfgName%=DISFORWARD,NT$ARCH$.10.0...22000

[DISFORWARD.NT$ARCH$.10.0...22000]
%DISFORWARD_SA.DeviceDesc%=DISFORWARD_SA, ROOT\DISFORWARD

[DestinationDirs]
DISFORWARD_SA.CopyList=13 ; 13=Package's DriverStore directory

;======================================================
; DISFORWARD_SA
;======================================================
[DISFORWARD_SA.CopyList]
disforwardaudio.sys

[DISFORWARD_SA.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,disforwardaudio.sys

;
; For demo only, please review these power management settings for your architecture. 
;
HKR,PowerSettings,SingleComponentMultiFxStates,3,1,0,0,0  ; Turn on multi Fx support.
HKR,PowerSettings,ConservationIdleTime,3,3,0,0,0          ; 3 seconds for idle power management when on battery
HKR,PowerSettings,PerformanceIdleTime,3,3,0,0,0           ; 3 seconds for idle power management when on AC power
HKR,PowerSettings,IdlePowerState,3,3,0,0,0                ; go to D3 for idle power management

HKR,Drivers,SubClasses,,"wave,midi,mixer"

HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\wave\wdmaud.drv,Description,,%DISFORWARD_SA.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DISFORWARD_SA.DeviceDesc%

;======================================================
; capture interfaces: mic array (internal: front)
;======================================================
[DISFORWARD.I.WaveMicArray1]
AddReg=DISFORWARD.I.WaveMicArray1.AddReg
[DISFORWARD.I.WaveMicArray1.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%DISFORWARD.WaveMicArray1.szPname%

[DISFORWARD.I.TopologyMicArray1]
AddReg=DISFORWARD.I.TopologyMicArray1.AddReg

[DISFORWARD.I.TopologyMicArray1.AddReg]
HKR,EP\0,"{a45c254e-df1c-4efd-8020-67d146a850e0},14",,"DISFORWARD"
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%DISFORWARD.TopologyMicArray1.szPname%

HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,"{D16F1100-13A4-4EA5-9D06-B12B91B58900},1",,"DISFORWARD.Native.1"

; The following lines opt-in to pull mode.
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

;======================================================
; render interfaces: speaker (internal)
;======================================================
[DISFORWARD.I.WaveSpeaker]
AddReg=DISFORWARD.I.WaveSpeaker.AddReg

[DISFORWARD.I.WaveSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%DISFORWARD.WaveSpeaker.szPname%

[DISFORWARD.I.TopologySpeaker]
AddReg=DISFORWARD.I.TopologySpeaker.AddReg

[DISFORWARD.I.TopologySpeaker.AddReg]
HKR,EP\0,"{a45c254e-df1c-4efd-8020-67d146a850e0},14",,"DISFORWARD Send"
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%DISFORWARD.TopologySpeaker.szPname%

HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,"{D16F1100-13A4-4EA5-9D06-B12B91B58900},1",,"DISFORWARD.Native.1"

; The following lines opt-in to pull mode.
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

;======================================================
; DISFORWARD_SA
;======================================================
[DISFORWARD_SA.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration
CopyFiles=DISFORWARD_SA.CopyList
AddReg=DISFORWARD_SA.AddReg

[DISFORWARD_SA.NT.Interfaces]
;
; Interfaces for speaker (internal) render endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveSpeaker%, DISFORWARD.I.WaveSpeaker
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveSpeaker%, DISFORWARD.I.WaveSpeaker
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveSpeaker%, DISFORWARD.I.WaveSpeaker
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopologySpeaker%, DISFORWARD.I.TopologySpeaker
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeaker%, DISFORWARD.I.TopologySpeaker

;
; Interfaces for microphone array 1 (internal: front) capture endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_WaveMicArray1%, DISFORWARD.I.WaveMicArray1
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveMicArray1%, DISFORWARD.I.WaveMicArray1
AddInterface=%KSCATEGORY_CAPTURE%,  %KSNAME_WaveMicArray1%, DISFORWARD.I.WaveMicArray1
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_TopologyMicArray1%, DISFORWARD.I.TopologyMicArray1
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyMicArray1%, DISFORWARD.I.TopologyMicArray1

[DISFORWARD_SA.NT.Services]
AddService=DisforwardAudio,0x00000002,DisforwardAudio_Service_Inst

[DisforwardAudio_Service_Inst]
DisplayName=%DisforwardAudio.SvcDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\disforwardaudio.sys

[DISFORWARD_SA.NT.HW]
AddReg = AUDIOHW.AddReg

[AUDIOHW.AddReg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x10001,0x0000001D
; SDDL_DEVOBJ_SYS_ALL_ADM_RWX_WORLD_RWX_RES_RWX
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"


;======================================================
; WDF
;======================================================
[DISFORWARD_SA.NT.Wdf]
KmdfService = DisforwardAudio, DISFORWARD_SA_WdfSect
[DISFORWARD_SA_WdfSect]
KmdfLibraryVersion = $KMDFVERSION$

;======================================================
; COMMON
;======================================================
[Strings]

;Non-localizable

KSNAME_WaveSpeaker="WaveSpeaker"
KSNAME_TopologySpeaker="TopologySpeaker"

KSNAME_WaveMicArray1="WaveMicArray1"
KSNAME_TopologyMicArray1="TopologyMicArray1"

Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME ="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"

KSNODETYPE_ANY   = "{00000000-0000-0000-0000-000000000000}"

PKEY_AudioEndpoint_Association               = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"

;Localizable

ProviderName = "DISFORWARD"
MfgName      = "DISFORWARD"
MsCopyRight  = "DISFORWARD; Microsoft sample portions retain original copyright"

DISFORWARD_SA.DeviceDesc="DISFORWARD Audio"
DisforwardAudio.SvcDesc="DISFORWARD Audio Driver"

;; friendly names
DISFORWARD.WaveSpeaker.szPname="DISFORWARD Send"
DISFORWARD.TopologySpeaker.szPname="DISFORWARD Send"

DISFORWARD.WaveMicArray1.szPname="DISFORWARD"
DISFORWARD.TopologyMicArray1.szPname="DISFORWARD"

MicArray1CustomName= "DISFORWARD"

